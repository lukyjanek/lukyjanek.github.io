---
interface Props {
  title: string;
  items: {
    name: string;
    description: string;
    url: string;
    versions?: string[];
    repository?: string;
  }[];
}

const { title, items } = Astro.props;
---

<section class="mb-12">
  <h2 class="text-3xl font-bold mb-8">{title}</h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {items.map((item) => (
      <div class="card bg-base-200 shadow-sm hover:shadow-md transition-all h-full flex flex-col">
        <div class="card-body p-6 flex flex-col flex-grow">
          <div class="mb-2">

            <h3 class="card-title text-xl mb-2">
              {item.name}
            </h3>
            
            {item.versions && item.versions.length > 0 && (
              <div class="flex flex-wrap items-center gap-2 text-xs">
                <span class="opacity-70 font-semibold uppercase tracking-wide">Participated on versions:</span>
                {item.versions.map((ver) => (
                  <span class="badge badge-sm badge-outline bg-base-100">{ver}</span>
                ))}
              </div>
            )}
          </div>

          <p class="text-base text-base-content/80 mb-4 flex-grow">
            {item.description}
          </p>

          <div class="mt-auto border-t border-base-content/10 pt-4 flex flex-wrap justify-end gap-3">

             <a href={item.url} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-ghost border border-base-content/20">
                Website
             </a>

             {item.repository && (
                <a href={item.repository} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary">
                   Repository
                </a>
             )}

          </div>

        </div>
      </div>
    ))}
  </div>
</section>