---
interface Props {
  listTitle: string;
  listItems: {
    title: string;
    type: string;
    link: string;
    linkname: string;
    description: string;
  }[];
}
const {listTitle, listItems} = Astro.props
---
<h2 class="text-2xl font-bold mb-6">{listTitle}</h2>
<div class="grid gap-6 mb-6">
  {
    listItems.map((item) => (
      <div class="p-6 bg-base-200 rounded-xl text-base-content">
        <h3 class="text-xl font-semibold mb-3">{item.title}</h3>
        <p>
          <strong>Type:</strong> {item.type}
          {item.link &&
            <br>
            <strong>Link:</strong> <a href={item.link} target="_blank" >{item.linkname}</a>
          }
        </p>
        <p>{item.description}</p>
      </div>
    ))
  }
</div>
