---
import Layout from "@/layouts/Layout.astro";
import PaperCard from '@/components/ui/PaperCard.astro';
import { publicationsJournals } from "@/data/cv";
import { publicationsConferences } from "@/data/cv";
import { publicationsTechReps } from "@/data/cv";

const JOURNAL_PAPERS = publicationsJournals;
const CONFERENCE_PAPERS = publicationsConferences;
const TECHREP_PAPERS = publicationsTechReps;

const SECTIONS = [
  {
    title: "Journal Papers",
    data: JOURNAL_PAPERS
  },
  {
    title: "Conference Proceedings",
    data: CONFERENCE_PAPERS
  },
  {
    title: "Technical Reports",
    data: TECHREP_PAPERS
  }
];
---

<Layout title="Publications | Lukáš Kyjánek">
  <h1 class="text-3xl font-bold mb-8">Publications</h1>
  <section>
    <div class="prose max-w-none">
      
      {SECTIONS.map((section) => (
        <div class="mb-12">
          
          <h2 class="text-xl font-bold mb-8 border-b border-base-300 pb-2">
              {section.title}
          </h2>

          <div class="space-y-6">
            {section.data.map((paper) => (
              <PaperCard paper={paper} />
            ))}
          </div>
          
        </div>
      ))}

    </div>
  </section>
</Layout>
